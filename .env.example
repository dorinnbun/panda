# ---- Required --------------------------------------------------------------
# Claude API key from https://platform.claude.com
ANTHROPIC_API_KEY=
# Passphrase for the dashboard login. Use something long.
ACCESS_PASSWORD=
# Signs login cookies. Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Token from Cloudflare Zero Trust > Networks > Tunnels > your tunnel
CLOUDFLARE_TUNNEL_TOKEN=

# ---- Personality -----------------------------------------------------------
ASSISTANT_NAME=Panda
OWNER_NAME=Dorinn
# How the assistant addresses you: sir, ma'am, boss, your first name...
OWNER_TITLE=sir
# IANA timezone, e.g. Asia/Phnom_Penh, Europe/London
TZ=UTC
# City for the weather panel and briefings
DEFAULT_LOCATION=

# ---- Model -----------------------------------------------------------------
PANDA_MODEL=claude-opus-5-5
# low = fastest spoken replies; medium/high = deeper reasoning, slower, costlier
PANDA_EFFORT=low
# Server-side retry on a different model if a request is declined ("off" to disable)
PANDA_FALLBACKS=default
# Live web search + page fetch through Claude's server tools ("off" to disable)
PANDA_WEB_SEARCH=on

# ---- Optional extras ---------------------------------------------------------
# Premium cinematic voice via ElevenLabs (otherwise the browser's voice is used)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Phone push for reminders via ntfy (install the ntfy app, subscribe to a long random topic)
NTFY_TOPIC_URL=
# Set to false only when testing over plain http://localhost
COOKIE_SECURE=true
