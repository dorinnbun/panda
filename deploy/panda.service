# Alternative to Docker: run directly with systemd.
#   sudo cp deploy/panda.service /etc/systemd/system/ && sudo systemctl enable --now panda
[Unit]
Description=Personal AI assistant
After=network-online.target

[Service]
User=panda
WorkingDirectory=/opt/panda
EnvironmentFile=/opt/panda/.env
ExecStart=/opt/panda/.venv/bin/uvicorn panda.main:app --host 127.0.0.1 --port 8000 --proxy-headers
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
